# Local development only. Supply deployment values through the hosting provider.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Comma-separated, explicit browser origins. Do not use a wildcard in production.
CORS_ORIGIN=http://localhost:3001

# Browser origin used to construct magic-link destinations. Loopback HTTP is
# accepted only in development; deployments must use HTTPS.
PUBLIC_WEB_ORIGIN=http://localhost:3001

# Generate each value independently: `openssl rand -base64 32 | tr '+/' '-_' | tr -d '='`.
# Placeholder values intentionally fail validation until replaced.
CATALOGUE_CURSOR_SIGNING_SECRET=REPLACE_WITH_INDEPENDENT_32_BYTE_BASE64URL_SECRET
AUTH_MAGIC_LINK_HASH_SECRET=REPLACE_WITH_INDEPENDENT_32_BYTE_BASE64URL_SECRET
AUTH_SESSION_HASH_SECRET=REPLACE_WITH_INDEPENDENT_32_BYTE_BASE64URL_SECRET
AUTH_CSRF_HASH_SECRET=REPLACE_WITH_INDEPENDENT_32_BYTE_BASE64URL_SECRET
AUTH_SOURCE_IP_HASH_SECRET=REPLACE_WITH_INDEPENDENT_32_BYTE_BASE64URL_SECRET

# Signs the dev/CI download adapter's short-TTL, single-use HMAC tokens
# (apps/api/src/entitlements/downloads/local-storage.adapter.ts). Independent
# of every other secret above; unused once a production presigned-URL storage
# adapter is wired (go-live storage-provider decision).
DOWNLOAD_TOKEN_HMAC_SECRET=REPLACE_WITH_INDEPENDENT_32_BYTE_BASE64URL_SECRET

# Verifies the `signature` field the build factory attaches to its
# server-to-server POST /v1/factory/artifacts ingest payload
# (apps/api/src/factory-ingest/factory-signature.guard.ts). Independent of
# every other secret above; shared only with the factory's own signer, never
# a browser-facing value.
FACTORY_INGEST_HMAC_SECRET=REPLACE_WITH_INDEPENDENT_32_BYTE_BASE64URL_SECRET

# Absolute path to the private local artifacts directory the dev/CI storage
# adapter streams from. Never served directly — only reachable through a
# verified, single-use download token minted by POST
# /v1/entitlements/:id/download.
LOCAL_ARTIFACT_STORAGE_DIR=/tmp/kitvera-local-artifacts

# --- Test-only end-to-end seam. NEVER set in production. ---
# When set (and NODE_ENV is not "production"), the magic-link email adapter
# stops suppressing deliveries and instead appends each one as a single JSON
# line — {"email","locale","link"} — to this file, so the Playwright auth suite
# can read a real magic-link URL from outside the API process. It delivers to no
# real vendor. In production this variable is ignored: the null/suppress adapter
# is wired regardless, so the capture file can never be produced there. Point it
# at a disposable, absolute path used only by the e2e run.
# E2E_MAGIC_LINK_CAPTURE_FILE=/tmp/kitvera-captured-magic-links.jsonl
