# Local development only. Supply deployment values through the hosting provider.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Comma-separated, explicit browser origins. Do not use a wildcard in production.
CORS_ORIGIN=http://localhost:3001

# Browser origin used to construct magic-link destinations. Loopback HTTP is
# accepted only in development; deployments must use HTTPS.
PUBLIC_WEB_ORIGIN=http://localhost:3001

# Generate each value independently: `openssl rand -base64 32 | tr '+/' '-_' | tr -d '='`.
# Placeholder values intentionally fail validation until replaced.
CATALOGUE_CURSOR_SIGNING_SECRET=REPLACE_WITH_INDEPENDENT_32_BYTE_BASE64URL_SECRET
AUTH_MAGIC_LINK_HASH_SECRET=REPLACE_WITH_INDEPENDENT_32_BYTE_BASE64URL_SECRET
AUTH_SESSION_HASH_SECRET=REPLACE_WITH_INDEPENDENT_32_BYTE_BASE64URL_SECRET
AUTH_CSRF_HASH_SECRET=REPLACE_WITH_INDEPENDENT_32_BYTE_BASE64URL_SECRET
AUTH_SOURCE_IP_HASH_SECRET=REPLACE_WITH_INDEPENDENT_32_BYTE_BASE64URL_SECRET
