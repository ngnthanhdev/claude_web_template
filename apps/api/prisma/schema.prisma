generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  normalizedEmail    String              @unique @map("normalized_email") @db.VarChar(320)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions           Session[]
  magicLinkTokens    MagicLinkToken[]
  authSecurityEvents AuthSecurityEvent[]
  roleAssignments    UserRole[]
  sellerProfile      SellerProfile?
  orders             Order[]
  entitlements       Entitlement[]
  downloadEvents     DownloadEvent[]
  adminAuditLogs     AdminAuditLog[]
  adminMfaFactors    AdminMfaFactor[]

  @@map("users")
}

model Session {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @map("user_id") @db.Uuid
  tokenHash          String              @unique @map("token_hash") @db.VarChar(255)
  csrfHash           String              @map("csrf_hash") @db.VarChar(255)
  idleExpiresAt      DateTime            @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt  DateTime            @map("absolute_expires_at") @db.Timestamptz(3)
  lastActivityAt     DateTime            @map("last_activity_at") @db.Timestamptz(3)
  lastRotatedAt      DateTime            @map("last_rotated_at") @db.Timestamptz(3)
  revokedAt          DateTime?           @map("revoked_at") @db.Timestamptz(3)
  rotatedToId        String?             @unique @map("rotated_to_id") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  rotatedTo          Session?            @relation("SessionRotation", fields: [rotatedToId], references: [id], onDelete: Restrict)
  rotatedFrom        Session?            @relation("SessionRotation")
  authSecurityEvents AuthSecurityEvent[]
  adminMfaSessions   AdminMfaSession[]

  @@index([userId, idleExpiresAt])
  @@index([idleExpiresAt])
  @@index([absoluteExpiresAt])
  @@index([userId, revokedAt, absoluteExpiresAt, idleExpiresAt], map: "sessions_user_active_expiry_idx")
  @@map("sessions")
}

enum AuthRateAction {
  magicLinkInitiation
  magicLinkRedemption
}

enum AuthSecurityEventKind {
  magicLinkIssueSucceeded
  magicLinkIssueFailed
  magicLinkRedemptionSucceeded
  magicLinkRedemptionFailed
  magicLinkRevoked
  sessionCreated
  sessionRotated
  sessionRevoked
  userSessionsRevoked
}

model AuthRateEvent {
  id              String         @id @default(uuid()) @db.Uuid
  action          AuthRateAction
  normalizedEmail String?        @map("normalized_email") @db.VarChar(320)
  sourceIpDigest  String         @map("source_ip_digest") @db.VarChar(64)
  occurredAt      DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([action, normalizedEmail, occurredAt], map: "auth_rate_events_email_window_idx")
  @@index([action, sourceIpDigest, occurredAt], map: "auth_rate_events_ip_window_idx")
  @@index([occurredAt])
  @@map("auth_rate_events")
}

model AuthSecurityEvent {
  id             String                @id @default(uuid()) @db.Uuid
  kind           AuthSecurityEventKind
  userId         String?               @map("user_id") @db.Uuid
  sessionId      String?               @map("session_id") @db.Uuid
  sourceIpDigest String?               @map("source_ip_digest") @db.VarChar(64)
  occurredAt     DateTime              @default(now()) @map("occurred_at") @db.Timestamptz(3)
  user           User?                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  session        Session?              @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([kind, occurredAt, id], map: "auth_security_events_kind_order_idx")
  @@index([userId, occurredAt, id], map: "auth_security_events_user_order_idx")
  @@index([sessionId, occurredAt, id], map: "auth_security_events_session_order_idx")
  @@map("auth_security_events")
}

model MagicLinkToken {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String?   @map("user_id") @db.Uuid
  normalizedEmail String    @map("normalized_email") @db.VarChar(320)
  locale          Locale
  returnTo        String    @map("return_to") @db.VarChar(2048)
  tokenHash       String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt      DateTime? @map("consumed_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user            User?     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@index([normalizedEmail, createdAt], map: "magic_link_tokens_email_created_at_idx")
  @@index([normalizedEmail, consumedAt, revokedAt, createdAt], map: "magic_link_tokens_email_state_created_at_idx")
  @@index([expiresAt])
  @@map("magic_link_tokens")
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  key         String     @unique @db.VarChar(64)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  assignments UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([roleId, userId])
  @@map("user_roles")
}

model SellerProfile {
  id        String    @id @default(uuid()) @db.Uuid
  ownerId   String    @unique @map("owner_id") @db.Uuid
  slug      String    @unique @db.VarChar(100)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  products  Product[]

  @@map("seller_profiles")
}

enum Locale {
  vi
  en
}

enum Currency {
  VND
  USD
}

enum PublicationState {
  draft
  published
  delisted
}

enum ReviewState {
  draft
  in_review
  approved
}

enum LicenceIdentifier {
  Regular
  Extended
}

enum MediaKind {
  image
  video
}

model Category {
  id           String                @id @default(uuid()) @db.Uuid
  slug         String                @unique @db.VarChar(120)
  parentId     String?               @map("parent_id") @db.Uuid
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  parent       Category?             @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]            @relation("CategoryHierarchy")
  translations CategoryTranslation[]
  products     Product[]

  @@index([parentId, slug])
  @@map("categories")
}

model CategoryTranslation {
  id         String   @id @default(uuid()) @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  locale     Locale
  name       String   @db.VarChar(200)
  summary    String   @db.Text
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([categoryId, locale])
  @@index([locale, name])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "category_translations_name_trigram_idx")
  @@map("category_translations")
}

model Product {
  id                  String                 @id @default(uuid()) @db.Uuid
  sellerId            String                 @map("seller_id") @db.Uuid
  categoryId          String                 @map("category_id") @db.Uuid
  slug                String                 @unique @db.VarChar(120)
  publicationState    PublicationState       @default(draft) @map("publication_state")
  currentVersion      String?                @map("current_version") @db.VarChar(64)
  thumbnailUrl        String                 @map("thumbnail_url") @db.Text
  documentationUrl    String                 @map("documentation_url") @db.Text
  isolatedPreviewUrl  String                 @map("isolated_preview_url") @db.Text
  publishedAt         DateTime?              @map("published_at") @db.Timestamptz(3)
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  seller              SellerProfile          @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  category            Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  currentVersionEntry ProductVersion?        @relation("CurrentProductVersion", fields: [id, currentVersion], references: [productId, version], onDelete: Restrict, onUpdate: Restrict)
  translations        ProductTranslation[]
  tags                ProductTag[]
  compatibility       ProductCompatibility[]
  specifications      ProductSpecification[]
  media               ProductMedia[]
  demoPages           ProductDemoPage[]
  versions            ProductVersion[]       @relation("ProductVersions")
  licenceOptions      LicenceOption[]
  orderItemSnapshots  OrderItemSnapshot[]
  entitlements        Entitlement[]
  downloadEvents      DownloadEvent[]

  @@unique([id, currentVersion])
  @@index([publicationState, categoryId, publishedAt, id])
  @@index([sellerId, publicationState, createdAt])
  @@map("products")
}

model ProductTranslation {
  id          String  @id @default(uuid()) @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  locale      Locale
  title       String  @db.VarChar(240)
  summary     String  @db.Text
  description String  @db.Text
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([productId, locale])
  @@index([locale, title])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "product_translations_title_trigram_idx")
  @@map("product_translations")
}

model Tag {
  id       String       @id @default(uuid()) @db.Uuid
  slug     String       @unique @db.VarChar(120)
  products ProductTag[]

  @@map("tags")
}

model ProductTag {
  productId String  @map("product_id") @db.Uuid
  tagId     String  @map("tag_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([productId, tagId])
  @@index([tagId, productId])
  @@map("product_tags")
}

model ProductCompatibility {
  id         String  @id @default(uuid()) @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  target     String  @db.VarChar(120)
  constraint String  @db.VarChar(255)
  product    Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([productId, target])
  @@map("product_compatibility")
}

model ProductSpecification {
  id           String                            @id @default(uuid()) @db.Uuid
  productId    String                            @map("product_id") @db.Uuid
  key          String                            @db.VarChar(120)
  product      Product                           @relation(fields: [productId], references: [id], onDelete: Restrict)
  translations ProductSpecificationTranslation[]

  @@unique([productId, key])
  @@map("product_specifications")
}

model ProductSpecificationTranslation {
  id              String               @id @default(uuid()) @db.Uuid
  specificationId String               @map("specification_id") @db.Uuid
  locale          Locale
  label           String               @db.VarChar(200)
  value           String               @db.Text
  specification   ProductSpecification @relation(fields: [specificationId], references: [id], onDelete: Restrict)

  @@unique([specificationId, locale])
  @@map("product_specification_translations")
}

model ProductMedia {
  id           String                    @id @default(uuid()) @db.Uuid
  productId    String                    @map("product_id") @db.Uuid
  position     Int
  kind         MediaKind
  url          String                    @db.Text
  product      Product                   @relation(fields: [productId], references: [id], onDelete: Restrict)
  translations ProductMediaTranslation[]

  @@unique([productId, position])
  @@map("product_media")
}

model ProductMediaTranslation {
  id      String       @id @default(uuid()) @db.Uuid
  mediaId String       @map("media_id") @db.Uuid
  locale  Locale
  alt     String       @db.Text
  media   ProductMedia @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([mediaId, locale])
  @@map("product_media_translations")
}

model ProductDemoPage {
  id           String                       @id @default(uuid()) @db.Uuid
  productId    String                       @map("product_id") @db.Uuid
  position     Int
  slug         String                       @db.VarChar(120)
  previewUrl   String                       @map("preview_url") @db.Text
  product      Product                      @relation(fields: [productId], references: [id], onDelete: Restrict)
  translations ProductDemoPageTranslation[]

  @@unique([productId, position])
  @@unique([productId, slug])
  @@map("product_demo_pages")
}

model ProductDemoPageTranslation {
  id         String          @id @default(uuid()) @db.Uuid
  demoPageId String          @map("demo_page_id") @db.Uuid
  locale     Locale
  title      String          @db.VarChar(240)
  demoPage   ProductDemoPage @relation(fields: [demoPageId], references: [id], onDelete: Restrict)

  @@unique([demoPageId, locale])
  @@map("product_demo_page_translations")
}

model ProductVersion {
  id           String                      @id @default(uuid()) @db.Uuid
  productId    String                      @map("product_id") @db.Uuid
  version      String                      @db.VarChar(64)
  releasedAt   DateTime                    @map("released_at") @db.Timestamptz(3)
  reviewState  ReviewState                 @default(draft) @map("review_state")
  product      Product                     @relation("ProductVersions", fields: [productId], references: [id], onDelete: Restrict)
  currentFor   Product?                    @relation("CurrentProductVersion")
  translations ProductVersionTranslation[]
  artifact     Artifact?
  buildRuns    BuildRun[]

  @@unique([productId, version])
  @@index([productId, releasedAt])
  @@index([productId, reviewState])
  @@map("product_versions")
}

model ProductVersionTranslation {
  id        String         @id @default(uuid()) @db.Uuid
  versionId String         @map("version_id") @db.Uuid
  locale    Locale
  notes     String         @db.Text
  version   ProductVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@unique([versionId, locale])
  @@map("product_version_translations")
}

model LicenceOption {
  id         String            @id @default(uuid()) @db.Uuid
  productId  String            @map("product_id") @db.Uuid
  identifier LicenceIdentifier
  product    Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  prices     Price[]

  @@unique([productId, identifier])
  @@map("licence_options")
}

model Price {
  id              String        @id @default(uuid()) @db.Uuid
  licenceOptionId String        @map("licence_option_id") @db.Uuid
  currency        Currency
  amount          Int
  licenceOption   LicenceOption @relation(fields: [licenceOptionId], references: [id], onDelete: Restrict)

  @@unique([licenceOptionId, currency])
  @@map("prices")
}

enum OrderStatus {
  pending
  settled
  cancelled
}

enum PaymentAttemptStatus {
  pending
  settled
  failed
}

enum PaymentProvider {
  sandbox
}

model Order {
  id              String              @id @default(uuid()) @db.Uuid
  userId          String              @map("user_id") @db.Uuid
  currency        Currency
  subtotalMinor   Int                 @map("subtotal_minor")
  discountMinor   Int                 @map("discount_minor")
  totalMinor      Int                 @map("total_minor")
  status          OrderStatus         @default(pending)
  idempotencyKey  String              @unique @map("idempotency_key") @db.VarChar(255)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  settledAt       DateTime?           @map("settled_at") @db.Timestamptz(3)
  user            User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  items           OrderItemSnapshot[]
  paymentAttempts PaymentAttempt[]
  entitlements    Entitlement[]

  @@index([userId, createdAt, id], map: "orders_user_id_created_at_id_idx")
  @@map("orders")
}

model OrderItemSnapshot {
  id                String            @id @default(uuid()) @db.Uuid
  orderId           String            @map("order_id") @db.Uuid
  productId         String            @map("product_id") @db.Uuid
  version           String            @db.VarChar(64)
  licenceIdentifier LicenceIdentifier @map("licence_identifier")
  titleSnapshot     String            @map("title_snapshot") @db.VarChar(240)
  unitPriceMinor    Int               @map("unit_price_minor")
  currency          Currency
  order             Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId], map: "order_item_snapshots_order_id_idx")
  @@map("order_item_snapshots")
}

model PaymentAttempt {
  id        String               @id @default(uuid()) @db.Uuid
  orderId   String               @map("order_id") @db.Uuid
  provider  PaymentProvider      @default(sandbox)
  status    PaymentAttemptStatus @default(pending)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  settledAt DateTime?            @map("settled_at") @db.Timestamptz(3)
  order     Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId], map: "payment_attempts_order_id_idx")
  @@map("payment_attempts")
}

model Entitlement {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  productId      String          @map("product_id") @db.Uuid
  version        String          @db.VarChar(64)
  orderId        String          @map("order_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  downloadEvents DownloadEvent[]

  @@unique([userId, productId])
  @@index([userId, createdAt, id], map: "entitlements_user_id_created_at_id_idx")
  @@map("entitlements")
}

model DownloadEvent {
  id             String      @id @default(uuid()) @db.Uuid
  entitlementId  String      @map("entitlement_id") @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  productId      String      @map("product_id") @db.Uuid
  version        String      @db.VarChar(64)
  issuedAt       DateTime    @default(now()) @map("issued_at") @db.Timestamptz(3)
  sourceIpDigest String      @map("source_ip_digest") @db.VarChar(64)
  entitlement    Entitlement @relation(fields: [entitlementId], references: [id], onDelete: Restrict)
  user           User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  product        Product     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([entitlementId, issuedAt, id], map: "download_events_entitlement_id_issued_at_id_idx")
  @@index([userId, issuedAt, id], map: "download_events_user_id_issued_at_id_idx")
  @@map("download_events")
}

enum BuildRunStatus {
  pending
  running
  succeeded
  failed
}

enum BuildVerdict {
  pending
  passed
  failed
}

model Artifact {
  id               String         @id @default(uuid()) @db.Uuid
  productVersionId String         @map("product_version_id") @db.Uuid
  storageId        String         @map("storage_id") @db.Text
  checksum         String         @db.VarChar(128)
  signature        String         @db.Text
  sizeBytes        BigInt         @map("size_bytes")
  producedAt       DateTime       @map("produced_at") @db.Timestamptz(3)
  factoryRunId     String         @map("factory_run_id") @db.VarChar(128)
  productVersion   ProductVersion @relation(fields: [productVersionId], references: [id], onDelete: Restrict)
  buildRuns        BuildRun[]

  @@unique([productVersionId], map: "artifacts_product_version_id_key")
  @@map("artifacts")
}

model BuildRun {
  id               String         @id @default(uuid()) @db.Uuid
  productVersionId String         @map("product_version_id") @db.Uuid
  status           BuildRunStatus @default(pending)
  startedAt        DateTime       @map("started_at") @db.Timestamptz(3)
  finishedAt       DateTime?      @map("finished_at") @db.Timestamptz(3)
  factoryRunId     String         @map("factory_run_id") @db.VarChar(128)
  artifactId       String?        @map("artifact_id") @db.Uuid
  qaVerdict        BuildVerdict   @default(pending) @map("qa_verdict")
  scanVerdict      BuildVerdict   @default(pending) @map("scan_verdict")
  productVersion   ProductVersion @relation(fields: [productVersionId], references: [id], onDelete: Restrict)
  artifact         Artifact?      @relation(fields: [artifactId], references: [id], onDelete: Restrict)

  @@unique([productVersionId, factoryRunId], map: "build_runs_product_version_id_factory_run_id_key")
  @@map("build_runs")
}

enum AdminAuditAction {
  reviewApproved
  reviewRejected
  productPublished
  productDelisted
  roleGranted
  roleRevoked
  mfaEnrolled
  mfaRecoveryRegenerated
}

enum AdminAuditTargetType {
  productVersion
  product
  userRole
  adminMfaFactor
}

enum AdminMfaFactorType {
  // TOTP is the only supported factor today; the enum is left open so a
  // WebAuthn factor type can be added later without a breaking migration.
  totp
}

// Append-only: admin actions are recorded here for accountability and are
// never updated or deleted after being written — there is intentionally
// no `updatedAt` field and no repository method that mutates or removes a
// row once inserted. `beforeState`/`afterState` are redacted diffs of the
// affected record (no secrets or PII), captured by the caller.
model AdminAuditLog {
  id            String               @id @default(uuid()) @db.Uuid
  actingAdminId String               @map("acting_admin_id") @db.Uuid
  action        AdminAuditAction
  targetType    AdminAuditTargetType @map("target_type")
  targetId      String               @map("target_id") @db.VarChar(64)
  beforeState   Json?                @map("before_state")
  afterState    Json?                @map("after_state")
  requestId     String?              @map("request_id") @db.VarChar(128)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  actingAdmin   User                 @relation(fields: [actingAdminId], references: [id], onDelete: Restrict)

  @@index([actingAdminId, createdAt, id], map: "admin_audit_logs_acting_admin_id_created_at_id_idx")
  @@index([targetType, targetId, createdAt], map: "admin_audit_logs_target_type_target_id_created_at_idx")
  @@map("admin_audit_logs")
}

// The TOTP shared secret is encrypted at rest (application-layer envelope
// encryption), not hashed, because verifying a code requires the plaintext
// secret back. Recovery codes (below) are the opposite: one-way hashed,
// since they are only ever compared, never decrypted. Neither value is
// ever logged.
model AdminMfaFactor {
  id              String                 @id @default(uuid()) @db.Uuid
  userId          String                 @map("user_id") @db.Uuid
  type            AdminMfaFactorType
  encryptedSecret String                 @map("encrypted_secret") @db.Text
  confirmedAt     DateTime?              @map("confirmed_at") @db.Timestamptz(3)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  user            User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  recoveryCodes   AdminMfaRecoveryCode[]

  // One active factor per (user, type): a user enrolls TOTP once, and
  // re-enrollment replaces the existing row rather than accumulating
  // duplicates.
  @@unique([userId, type])
  @@map("admin_mfa_factors")
}

model AdminMfaRecoveryCode {
  id        String         @id @default(uuid()) @db.Uuid
  factorId  String         @map("factor_id") @db.Uuid
  codeHash  String         @map("code_hash") @db.VarChar(255)
  usedAt    DateTime?      @map("used_at") @db.Timestamptz(3)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  factor    AdminMfaFactor @relation(fields: [factorId], references: [id], onDelete: Restrict)

  @@index([factorId], map: "admin_mfa_recovery_codes_factor_id_idx")
  @@map("admin_mfa_recovery_codes")
}

// Marks that a session has completed an admin MFA challenge, so the
// step-up enforcement guard (a later round) can require a sufficiently
// recent `verifiedAt` before allowing an admin action. One row per
// successful challenge; the guard reads the most recent row for the
// session.
model AdminMfaSession {
  id         String   @id @default(uuid()) @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  verifiedAt DateTime @map("verified_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId], map: "admin_mfa_sessions_session_id_idx")
  @@map("admin_mfa_sessions")
}
