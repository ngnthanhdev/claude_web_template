# Local development only. Supply deployment values through the hosting provider.

# Server-only: the real API origin. Read exclusively by the same-origin proxy
# route (apps/web/src/app/api/[...proxy]/route.ts), which forwards allowlisted
# /v1/* requests to it. Deliberately NOT prefixed with NEXT_PUBLIC_ — the
# browser must never learn this origin or call it directly; it only ever
# calls this app's own /api/v1/* paths.
API_ORIGIN=http://localhost:3000
